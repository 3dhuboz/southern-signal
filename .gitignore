.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

pi-hub/data/
pi-hub/app/**/__pycache__/
pi-hub/tests/**/__pycache__/

# pwa
pwa/node_modules/
pwa/dist/
pwa/.vite/
pwa/.wrangler/
pwa/.audit-tmp/
# Prevent npm/yarn lockfiles from sneaking back in alongside pnpm-lock.yaml
# (CI uses pnpm; a second lockfile causes resolver drift — see deploy.yml).
pwa/package-lock.json
pwa/yarn.lock

# Repo-root pnpm artifacts. The empty pnpm-workspace.yaml at root exists
# only to interrupt pnpm 10.x's upward directory walk on Windows (so it
# doesn't find an unrelated workspace in the user's home dir). The real
# lock + node_modules live at pwa/pnpm-lock.yaml + pwa/node_modules/.
/node_modules/
/pnpm-lock.yaml

*.log
.DS_Store
Thumbs.db

# Local Codex/agent scratch state
/.codex/
/.claude/worktrees/
